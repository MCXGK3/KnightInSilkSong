<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
     <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <SilksongFolder>F:\r2modman_mod\HollowKnightSilksong\profiles\develop</SilksongFolder>
    <UnityFolder> D:\unity\UnityProjects\BETTERALLHK\Assets\Plugins</UnityFolder>
    <PublishFolder>E:\Github_Projects\Mod\SS</PublishFolder>
    <ManagedDir>F:\SteamLibrary\steamapps\common\Hollow Knight Silksong\Hollow Knight Silksong_Data\Managed\</ManagedDir>
    <ModName>KnightInSilkSong</ModName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <LocalReferences Include="$(ManagedDir)*.dll" Exclude="$(ManagedDir)Mono*.dll;$(ManagedDir)netstandard.dll;$(ManagedDir)System*.dll;$(ManagedDir)mscorlib.dll" />
    <Reference Include="@(LocalReferences)" Private="false" Publicize="true" />
    <!-- <PackageReference Include="Silksong.GameLibs" Version="1.1.0-silksong1.0.28650" /> -->
    <PackageReference Include="UnityEngine.Modules" Version="6000.0.50" IncludeAssets="compile" />
  </ItemGroup>
  <Target Name="CopyDLL" AfterTargets="PostBuildEvent" Condition="'$(SilksongFolder)' != ''">
      <ItemGroup>
          <Binaries Include="$(TargetPath)" />
          <Binaries Include="$(TargetDir)/$(TargetName).pdb" />
      </ItemGroup>

      <Copy SourceFiles="@(Binaries)" DestinationFolder="$(SilksongFolder)/BepInEx/plugins/$(ModName)" />
      <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityFolder)"/>

  </Target>
  <Target Name="BuildPushishPack" AfterTargets="CopyDLL" Condition="'$(PublishFolder)' != ''">
      <ItemGroup>
          <Binaries Include="$(TargetPath)" />
          <Binaries Include="$(TargetDir)/$(TargetName).pdb" />
      </ItemGroup>
      <Copy SourceFiles="@(Binaries)" DestinationFolder="$(PublishFolder)/$(ModName)/ThunderStore" />
      <Copy SourceFiles="@(Binaries)" DestinationFolder="$(PublishFolder)/$(ModName)/GitHub" />
      </Target>

</Project>
